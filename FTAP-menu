-- ========== БРОСОК ==========
local function launch(part)
    if not part or not part.Parent then return end
    if player.Character and part:IsDescendantOf(player.Character) then return end

    local vel = workspace.CurrentCamera.CFrame.LookVector * strength
    local frames = 0
    local conn
    conn = RunService.Heartbeat:Connect(function()
        frames += 1
        if part and part.Parent then
            part.AssemblyLinearVelocity = vel
        end
        if frames >= 6 then conn:Disconnect() end
    end)
end

local function onGrab(grabParts)
    local held
    local alive = true

    task.spawn(function()
        local grabPart = grabParts:WaitForChild("GrabPart", 3)
        local weld = grabPart and grabPart:WaitForChild("WeldConstraint", 3)
        while alive and weld do
            if weld.Part1 then held = weld.Part1 end
            task.wait()
        end
    end)

    grabParts.AncestryChanged:Connect(function(_, newParent)
        if not newParent then
            alive = false
            launch(held)
        end
    end)
end

workspace.ChildAdded:Connect(function(child)
    if child.Name == "GrabParts" then onGrab(child) end
end)
local existing = workspace:FindFirstChild("GrabParts")
if existing then onGrab(existing) end

-- ========== ЗАЩИТА ==========
local anchoredSince = nil
local ignoreUntil = 0
local lastStruggle = 0

local function grabbedBySomeone(char)
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") then
            local owner = part:FindFirstChild("PartOwner")
            if owner and tostring(owner.Value) ~= player.Name then
                return true
            end
        end
    end
    return false
end

RunService.Heartbeat:Connect(function()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not protect then
        if anchoredSince then
            hrp.Anchored = false
            anchoredSince = nil
        end
        return
    end

    local now = os.clock()
    if now < ignoreUntil then return end

    if grabbedBySomeone(char) then
        if not anchoredSince then
            anchoredSince = now
            hrp.Anchored = true
        end

        -- пробуем "вырваться" через событие игры (если оно есть)
        if now - lastStruggle > 0.1 then
            lastStruggle = now
            local ge = ReplicatedStorage:FindFirstChild("GrabEvents")
            local st = ge and ge:FindFirstChild("Struggle")
            if st then pcall(function() st:FireServer(hrp) end) end
        end

        -- страховка: не держим якорь вечно
        if now - anchoredSince > 2 then
            hrp.Anchored = false
            anchoredSince = nil
            ignoreUntil = now + 0.5
        end
    elseif anchoredSince then
        hrp.Anchored = false
        anchoredSince = nil
    end
end)
